[Desktop Entry]
Type=Application
Name=Remy'a Launcher
Comment=Open Remy'a Launcher
Exec=remya_launcher
Icon=top.remya.launcher
Terminal=false
Categories=Utility;
Actions=Clipboard;settings;

[Desktop Action Clipboard]
Name=Clipboard History
Exec=remya_launcher --clipboard

[Desktop Action settings]
Name=Settings
Exec=remya_launcher --settings
